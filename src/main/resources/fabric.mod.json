{
  "schemaVersion": 1,
  "id": "voxelmind_local",
  "version": "${version}",
  "name": "VoxelMind",
  "description": "AI beings that live in your world: a companion with a real player body, a Builder fairy and a God game master. They think with the AI you choose: VoxelMind Sparks, Player2, your own OpenRouter account or a local model.",
  "icon": "assets/voxelmind_local/icon.png",
  "authors": [
    "Nyvoro UG"
  ],
  "contact": {
    "homepage": "https://voxel-mind.com",
    "issues": "https://discord.gg/gtJV3XgDWy"
  },
  "license": "MIT",
  "custom": {
    "modmenu": {
      "links": {
        "voxelmind_local.modmenu.feature_request": "https://discord.gg/jRthVZV2uk",
        "voxelmind_local.modmenu.support": "https://ko-fi.com/voxelmind"
      }
    }
  },
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.voxelmind.local.VoxelMindLocal"
    ],
    "client": [
      "com.voxelmind.local.client.VoxelMindLocalClient"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}",
    "fabric-api": ">=${fabric_version}"
  },
  "mixins": [
    "voxelmind_local.mixins.json"
  ]
}